{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "File patterns for enabled managers",
  customManagers: [
    {
      customType: "regex",
      description: "Forgejo runner job images in runner labels",
      managerFilePatterns: ["/^kubernetes/.+/forgejo/runner/resources/config\\.yaml$/"],
      matchStrings: [":docker://(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      datasourceTemplate: "docker",
      versioningTemplate: "regex:^ubuntu-(?<major>\\d+)\\.(?<minor>\\d+)$",
    },
  ],
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: ["/^kubernetes/bootstrap/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kubernetes/.+/kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
}
